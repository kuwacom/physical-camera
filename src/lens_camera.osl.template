// MAX_SURFACES / N_EXTRA / MAX_EXTRA は lenses.py の値と一致させるため codegen.py がレンズデータ部に出力する

#define SURFACE_SPHERICAL     0
#define SURFACE_FLAT          1
#define SURFACE_STOP          2
#define SURFACE_ASPHERIC      3
#define SURFACE_CYLINDRICAL_X 4
#define SURFACE_CYLINDRICAL_Y 5

// ライト照準と一様標本化を 1 サンプル MIS で混ぜる割合 (照準側)
#define LIGHT_AIM_FRACTION 0.7
// サンのライトデータは半径 0 のため、照準のジッタには実際の太陽の角半径 (rad) を使う
#define SUN_ANGULAR_RADIUS 0.00436

// extra[i*N_EXTRA + 0] = k (conic constant)
// extra[i*N_EXTRA + 1] = A4 (4th-order aspheric coefficient)
// extra[i*N_EXTRA + 2] = A6 (6th-order aspheric coefficient)
// extra[i*N_EXTRA + 3] = A8 (8th-order aspheric coefficient)
// extra[i*N_EXTRA + 4] = A10 (10th-order aspheric coefficient)
// extra[i*N_EXTRA + 5..7] = reserved

// {{LENS_DATA}}

// {{SCENE_LIGHTS}}

// 配列のシェーダーパラメーターは Cycles のカメラに渡らないため、ライト 1 灯を vector 2 つで受け取り配列へ展開する
// geom: 点光源はワールド位置 (m)、サンは光源方向 (ワールド)。info: (種類, 強度, 半径 mm)
void unpack_scene_light(
    int li, vector geom, vector info,
    output int light_types[MAX_LIGHTS],
    output float light_pos[MAX_LIGHTS_3],
    output float light_dir[MAX_LIGHTS_3],
    output float light_intensity[MAX_LIGHTS],
    output float light_radius[MAX_LIGHTS])
{
    int type = int(info[0]);
    light_types[li] = type;
    for (int k = 0; k < 3; k++) {
        light_pos[li*3+k] = (type == 1) ? 0.0 : geom[k];
        light_dir[li*3+k] = (type == 1) ? geom[k] : 0.0;
    }
    light_intensity[li] = info[1];
    light_radius[li] = info[2];
}

// Transform world-space light data to lens space.
// Blender's "camera" space has +Z toward the scene; lens space has -Z,
// so Z is negated (matching the output conversion: position.z = -lens_z).
void transform_lights_to_camera(
    int num_lights,
    int light_types[MAX_LIGHTS],
    float light_pos[MAX_LIGHTS_3],
    float light_dir[MAX_LIGHTS_3])
{
    for (int li = 0; li < num_lights; li++) {
        point wp = point(light_pos[li*3], light_pos[li*3+1], light_pos[li*3+2]);
        point cp = transform("world", "camera", wp);
        light_pos[li*3+0] = cp[0] * 1000.0;
        light_pos[li*3+1] = cp[1] * 1000.0;
        light_pos[li*3+2] = -cp[2] * 1000.0;

        if (light_types[li] == 1) {
            vector wd = vector(light_dir[li*3], light_dir[li*3+1], light_dir[li*3+2]);
            vector cd = transform("world", "camera", wd);
            light_dir[li*3+0] = cd[0];
            light_dir[li*3+1] = cd[1];
            light_dir[li*3+2] = -cd[2];
        }
    }
}

// Integer hash: decorrelated random values from the two camera random
// samples. Each salt value yields an independent uniform [0,1] variate.
float rng(float a, float b, int salt)
{
    int h = int(a * 16384.0) + salt;
    h = h + (h << 10);
    h = h ^ (h >> 6);
    h = h + int(b * 16384.0);
    h = h + (h << 10);
    h = h ^ (h >> 6);
    h = h + (h << 3);
    h = h ^ (h >> 11);
    h = h + (h << 15);
    return float((h ^ (h >> 16)) & 32767) / 32767.0;
}

// Cauchy dispersion: n(λ) = A + B/λ², coefficients derived from n_d and Abbe number.
float cauchy_ior(float n_d, float v_d, float lambda_nm)
{
    if (v_d < 1.0 || n_d <= 1.0)
        return n_d;

    float inv_lF2 = 1.0 / (486.1 * 486.1);
    float inv_lC2 = 1.0 / (656.3 * 656.3);
    float inv_ld2 = 1.0 / (587.6 * 587.6);
    float B = (n_d - 1.0) / (v_d * (inv_lF2 - inv_lC2));
    float A = n_d - B * inv_ld2;
    return A + B / (lambda_nm * lambda_nm);
}

color wavelength_to_rgb(float lambda)
{
    // Wyman et al. 2013 piecewise Gaussian fits to CIE 1931 XYZ
    float t1 = (lambda - 442.0) * ((lambda < 442.0) ? 0.0624 : 0.0374);
    float t2 = (lambda - 599.8) * ((lambda < 599.8) ? 0.0264 : 0.0323);
    float t3 = (lambda - 501.1) * ((lambda < 501.1) ? 0.0490 : 0.0382);
    float x = 0.362 * exp(-0.5*t1*t1) + 1.056 * exp(-0.5*t2*t2) - 0.065 * exp(-0.5*t3*t3);

    float t4 = (lambda - 568.8) * ((lambda < 568.8) ? 0.0213 : 0.0247);
    float t5 = (lambda - 530.9) * ((lambda < 530.9) ? 0.0613 : 0.0322);
    float y = 0.821 * exp(-0.5*t4*t4) + 0.286 * exp(-0.5*t5*t5);

    float t6 = (lambda - 437.0) * ((lambda < 437.0) ? 0.0845 : 0.0278);
    float t7 = (lambda - 459.0) * ((lambda < 459.0) ? 0.0385 : 0.0725);
    float z = 1.217 * exp(-0.5*t6*t6) + 0.681 * exp(-0.5*t7*t7);

    // XYZ -> linear sRGB (D65)
    float r =  3.2406 * x - 1.5372 * y - 0.4986 * z;
    float g = -0.9689 * x + 1.8758 * y + 0.0415 * z;
    float b =  0.0557 * x - 0.2040 * y + 1.0570 * z;

    return color(max(r, 0.0), max(g, 0.0), max(b, 0.0));
}

// Thin-film interference reflectance for coated/uncoated surfaces.
// Returns the actual reflectance R (fraction of power reflected).
float coated_reflectance(float n1, float n2, float cos_i, float cos_t,
                         float lambda_nm, float coating)
{
    if (n1 == n2)
        return 0.0;

    // Bare Fresnel reflectance (s and p polarization averaged)
    float rs = (n1 * cos_i - n2 * cos_t) / (n1 * cos_i + n2 * cos_t);
    float rp = (n1 * cos_t - n2 * cos_i) / (n1 * cos_t + n2 * cos_i);
    float R_bare = (rs * rs + rp * rp) * 0.5;

    // Uncoated or cemented (glass-glass interface): bare Fresnel only
    if (coating < 0.5 || min(n1, n2) >= 1.01)
        return R_bare;

    // Quarter-wave MgF2 thin-film coating (Airy formula)
    float nc = 1.38;
    float lambda0 = 550.0;
    float lo = min(n1, n2);
    float hi = max(n1, n2);

    // Snell's law into the coating layer (cos_i is measured in medium n1)
    float sin_i2 = 1.0 - cos_i * cos_i;
    float sin_c2 = (n1 * n1) / (nc * nc) * sin_i2;
    float cos_c = (sin_c2 < 1.0) ? sqrt(1.0 - sin_c2) : 0.0;

    // Round-trip phase through the coating
    float delta = M_PI * (lambda0 / lambda_nm) * cos_c;

    // Amplitude reflection coefficients at coating interfaces
    float r1 = (lo - nc) / (lo + nc);
    float r2 = (nc - hi) / (nc + hi);

    // Airy formula for thin-film reflectance
    float cos_d = cos(delta);
    float r1r2 = r1 * r2;
    float R_film = (r1 * r1 + r2 * r2 + 2.0 * r1r2 * cos_d)
                 / (1.0 + r1r2 * r1r2 + 2.0 * r1r2 * cos_d);

    if (coating < 1.5)
        return R_film;

    // Multicoating: power-law boost deepens the on-design minimum while
    // preserving the spectral and angular shape from the Airy formula.
    // Clamped to bare Fresnel — real multicoatings never exceed uncoated.
    float R_normal = (lo - hi) * (lo - hi) / ((lo + hi) * (lo + hi));
    float ratio = (R_normal > 1e-10) ? R_film / R_normal : 1.0;
    return min(R_normal * ratio * ratio * ratio, R_bare);
}

float fresnel_transmittance(float n1, float n2, float cos_i, float cos_t,
                            float lambda_nm, float coating)
{
    if (n1 == n2)
        return 1.0;
    return 1.0 - coated_reflectance(n1, n2, cos_i, cos_t, lambda_nm, coating);
}

int point_in_ngon(float x, float y, float semi_ap, int num_blades, float rotation_rad)
{
    float r = sqrt(x * x + y * y);
    if (r < 1e-10)
        return 1;
    float sector_angle = 2.0 * M_PI / float(num_blades);
    float angle = atan2(y, x) - rotation_rad;
    angle = angle - floor(angle / (2.0 * M_PI)) * 2.0 * M_PI;
    float theta = mod(angle, sector_angle) - sector_angle * 0.5;
    float max_r = semi_ap * cos(M_PI / float(num_blades)) / cos(theta);
    return (r <= max_r) ? 1 : 0;
}

// Project ray to a z-plane and check circular or n-gon aperture.
// Returns 1 if the ray passes, 0 if projection fails, -1 if clipped.
// Sets out_p to the projected point on success.
int check_aperture_at_plane(
    point p, vector d,
    float plane_z, float semi_aperture,
    int surface_type, int num_blades, float blade_rotation,
    output point out_p)
{
    if (abs(d[2]) <= 1e-10)
        return 0;

    float t = (plane_z - p[2]) / d[2];
    float hx = p[0] + t * d[0];
    float hy = p[1] + t * d[1];

    if (surface_type == SURFACE_STOP && num_blades >= 3) {
        if (!point_in_ngon(hx, hy, semi_aperture, num_blades, blade_rotation))
            return -1;
    } else {
        float r = sqrt(hx * hx + hy * hy);
        if (r > semi_aperture)
            return -1;
    }

    out_p = point(hx, hy, plane_z);
    return 1;
}

// Snell's law at a flat surface with Fresnel transmittance.
// Returns 1 on success, 0 on TIR.
int refract_at_flat_plane(
    vector d_in, float n1, float n2, float lambda_nm, float coating,
    output vector d_out, output float transmission)
{
    if (n1 == n2) {
        d_out = d_in;
        transmission = 1.0;
        return 1;
    }

    vector N = vector(0, 0, -1);
    vector I = normalize(d_in);
    if (dot(I, N) > 0.0)
        N = -N;
    float cos_i = abs(dot(I, N));
    vector refracted = refract(I, N, n1 / n2);
    if (dot(refracted, refracted) < 1e-10)
        return 0;
    float cos_t = abs(dot(refracted, N));
    transmission = fresnel_transmittance(n1, n2, cos_i, cos_t, lambda_nm, coating);
    d_out = refracted;
    return 1;
}

// 直接光の正規化 (戻り値) とゴーストの組重み (surface_R) は同じ垂直入射反射率を使うため、
// 1 回の走査で両方を求めて coated_reflectance の呼び出しを光線あたり 1 面 1 回に抑える
float onaxis_fresnel_transmission(
    int num_surfaces,
    float iors[MAX_SURFACES],
    float lambda_nm,
    float coating,
    output float surface_R[MAX_SURFACES])
{
    float T = 1.0;
    for (int idx = num_surfaces - 1; idx >= 0; idx--) {
        surface_R[idx] = 0.0;
        float n1 = iors[idx];
        float n2 = (idx > 0) ? iors[idx - 1] : 1.0;
        if (n1 == n2)
            continue;
        float R = coated_reflectance(n1, n2, 1.0, 1.0, lambda_nm, coating);
        surface_R[idx] = R;
        T *= 1.0 - R;
    }
    return T;
}

int is_curved_surface(int surface_type) {
    return (surface_type == SURFACE_SPHERICAL || surface_type == SURFACE_ASPHERIC
            || surface_type == SURFACE_CYLINDRICAL_X || surface_type == SURFACE_CYLINDRICAL_Y);
}

// 絞り面だけ f 値に応じて開口を縮める規則を、追跡・ABCD の全経路で揃えるため 1 か所にまとめる
float surface_semi_aperture(
    int idx,
    float apertures[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    float aperture_scale)
{
    float semi_ap = apertures[idx] * 0.5;
    if (surface_types[idx] == SURFACE_STOP)
        semi_ap *= aperture_scale;
    return semi_ap;
}

// X/Y 別の ABCD 行列に面のパワー phi を掛ける。シリンドリカル面の軸の扱いを射出瞳とゴーストで共有する
void apply_abcd_power(
    float phi, int surface_type,
    float Ax, float Bx, float Ay, float By,
    output float Cx, output float Dx, output float Cy, output float Dy)
{
    // Spherical/aspheric: power in both axes
    // Cylindrical_x: power in X only
    // Cylindrical_y: power in Y only
    if (surface_type != SURFACE_CYLINDRICAL_Y) {
        Cx -= phi * Ax;
        Dx -= phi * Bx;
    }
    if (surface_type != SURFACE_CYLINDRICAL_X) {
        Cy -= phi * Ay;
        Dy -= phi * By;
    }
}

float compute_sensor_distance(
    int num_surfaces,
    float radii[MAX_SURFACES],
    float thicknesses[MAX_SURFACES],
    float iors[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    float total_length,
    float focus_mm)
{
    // Build ABCD system matrix by front-to-back paraxial ray trace (Y axis).
    // For anamorphic lenses, sensor distance is derived from Y (spherical
    // meridian) — matching how cinematographers focus anamorphic lenses.
    // Cylindrical_x surfaces have no power in Y; cylindrical_y surfaces do.
    float A = 1.0, B = 0.0, C = 0.0, D = 1.0;

    for (int i = 0; i < num_surfaces; i++) {
        float n_before = (i == 0) ? 1.0 : iors[i - 1];
        float n_after = iors[i];

        // Refraction matrix — skip surfaces with no Y-axis power
        if (is_curved_surface(surface_types[i]) && n_before != n_after
            && surface_types[i] != SURFACE_CYLINDRICAL_X) {
            float phi = (n_after - n_before) / radii[i];
            C -= phi * A;
            D -= phi * B;
        }

        // Transfer matrix (skip after last surface)
        if (i < num_surfaces - 1) {
            float t = thicknesses[i] / iors[i];
            A += t * C;
            B += t * D;
        }
    }

    // Fall back to infinity focus if the system has no optical power
    // C≈0 では -A/C が発散するため、codegen が無限遠間隔で求めた値を使う
    if (abs(C) < 1e-10)
        return SENSOR_DISTANCE_INF;

    float f = -1.0 / C;
    float bfd = -A / C;
    float rpp = (1.0 - A) / C;
    float fpp = (D - 1.0) / C;

    if (focus_mm <= 0.0)
        return bfd;

    float d_o = focus_mm - total_length + fpp;
    // d_o <= f では実像ができず、無限遠の bfd を返すとピントが不連続に飛ぶため、
    // 実用レンズの限界である等倍 (d_o = 2f) を下限にして最も近いピント位置に留める
    d_o = max(d_o, 2.0 * f);

    float d_i = f * d_o / (d_o - f);
    return rpp + d_i;
}

void compute_exit_pupil(
    int num_surfaces,
    float radii[MAX_SURFACES],
    float thicknesses[MAX_SURFACES],
    float iors[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    output float ep_z_x, output float ep_mag_x,
    output float ep_z_y, output float ep_mag_y)
{
    int stop_index = STOP_INDEX;

    // Build dual ABCD matrices for the rear subsystem (stop -> rear vertex).
    // Separate X and Y axes to handle cylindrical surfaces correctly.
    float Ax = 1.0, Bx = 0.0, Cx = 0.0, Dx = 1.0;
    float Ay = 1.0, By = 0.0, Cy = 0.0, Dy = 1.0;

    // Initial transfer from stop to first rear surface
    float t = thicknesses[stop_index] / iors[stop_index];
    Ax += t * Cx;  Bx += t * Dx;
    Ay += t * Cy;  By += t * Dy;

    for (int i = stop_index + 1; i < num_surfaces; i++) {
        float n_before = iors[i - 1];
        float n_after = iors[i];

        if (is_curved_surface(surface_types[i]) && n_before != n_after) {
            float phi = (n_after - n_before) / radii[i];
            apply_abcd_power(phi, surface_types[i], Ax, Bx, Ay, By, Cx, Dx, Cy, Dy);
        }

        if (i < num_surfaces - 1) {
            t = thicknesses[i] / iors[i];
            Ax += t * Cx;  Bx += t * Dx;
            Ay += t * Cy;  By += t * Dy;
        }
    }

    if (abs(Dx) < 1e-10) {
        ep_z_x = 0.0;
        ep_mag_x = 0.0;
    } else {
        ep_z_x = -Bx / Dx;
        ep_mag_x = abs(1.0 / Dx);
    }

    if (abs(Dy) < 1e-10) {
        ep_z_y = 0.0;
        ep_mag_y = 0.0;
    } else {
        ep_z_y = -By / Dy;
        ep_mag_y = abs(1.0 / Dy);
    }
}

// 円 (c1, r1) と円 (c2, r2) の共通部分を含む円で (c1, r1) を置き換える。共通部分が空なら r1 = 0
// 標本化円盤は面積で重み付けするため、共通部分の内接円ではなく外接円にしないと通過できる光線を取りこぼして暗くなる
void bound_disk_intersection(
    output float c1x, output float c1y, output float r1,
    float c2x, float c2y, float r2)
{
    float dx = c2x - c1x;
    float dy = c2y - c1y;
    float d = sqrt(dx * dx + dy * dy);
    if (d >= r1 + r2) {
        r1 = 0.0;
        return;
    }
    if (d + r1 <= r2)
        return;
    if (d + r2 <= r1) {
        c1x = c2x;  c1y = c2y;  r1 = r2;
        return;
    }
    // 弦の中点から両方の弧の頂点までが半弦長以内なら、弦を直径とする円が共通部分 (レンズ形) を含む
    float a = (d * d + r1 * r1 - r2 * r2) / (2.0 * d);
    float h = sqrt(max(r1 * r1 - a * a, 0.0));
    if (r1 - a <= h && r2 - (d - a) <= h) {
        c1x += dx / d * a;
        c1y += dy / d * a;
        r1 = h;
    } else if (r2 < r1) {
        // 片方の弧が半円を超えるときは、どちらの円も共通部分を含むので小さい方を使う
        c1x = c2x;  c1y = c2y;  r1 = r2;
    }
}

// sx / sy は射出瞳の楕円を半径 aim_semi_ap の円に写す倍率で、円の計算はこの正規化座標で行う
// 戻り値の ep_cx / ep_cy は実座標、ep_r は正規化座標の半径。clipped は後群の制約で絞りの像より小さい円になったか
// 円盤は通過領域を含む側 (外接) で取る。重みに円盤の面積を掛けるので、内側に切ると通過できる光線を落として暗くなる
void compute_field_exit_pupil(
    float sensor_x, float sensor_y, float sensor_z,
    float ep_z, float stop_semi_ap, float aim_semi_ap, float sx, float sy,
    int num_surfaces,
    float radii[MAX_SURFACES],
    float thicknesses[MAX_SURFACES],
    float iors[MAX_SURFACES],
    float apertures[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    output float ep_cx, output float ep_cy, output float ep_r, output int clipped)
{
    int stop_index = STOP_INDEX;

    // 後群の制約を先に積み、最後に絞りの像と交わらせる。初期円は後群の制約に必ず含まれる大きさにする
    float cx = 0.0, cy = 0.0;
    ep_r = 1e10;
    clipped = 0;
    // 絞りの像は近軸では照準面の原点中心 (主光線は射出瞳中心を通る)。近軸追跡が退化したときの代わり
    float stop_cx = 0.0, stop_cy = 0.0, stop_r = aim_semi_ap;

    // 後群の各面での光線高は (センサー位置, 照準点) の一次式なので、基底 2 本 (センサー 1 / 照準 0、センサー 0 / 照準 1) を
    // 後面頂点から絞り側へ近軸追跡して係数を得る。直線で射影すると間の面の屈折を無視して制約円を誤る
    // 後面頂点 z=0 から被写体側へ進む向きを正とした角度 u = -dy/dz を使う
    float inv_dz = 1.0 / (ep_z - sensor_z);
    float ya_x = ep_z * inv_dz, ua_x = inv_dz;
    float yb_x = -sensor_z * inv_dz, ub_x = -inv_dz;
    float ya_y = ya_x, ua_y = ua_x, yb_y = yb_x, ub_y = ub_x;

    for (int i = num_surfaces - 1; i >= stop_index; i--) {
        // 明るいレンズでは瞳の収差で実際の通過領域が近軸の射出瞳より広がるため、絞りにも後群と同じ余裕を付ける
        if (i == stop_index) {
            if (abs(yb_x) > 1e-10 && abs(yb_y) > 1e-10) {
                stop_cx = -ya_x * sensor_x / yb_x * sx;
                stop_cy = -ya_y * sensor_y / yb_y * sy;
                stop_r = stop_semi_ap * max(sx / abs(yb_x), sy / abs(yb_y));
            }
            stop_r *= 1.1;
            break;
        }

        float semi_ap = apertures[i] * 0.5;

        // Constraint circle: projection of surface i's aperture onto the EP plane
        // Safety margin: paraxial projection doesn't account for aberrations
        if (abs(yb_x) > 1e-10 && abs(yb_y) > 1e-10) {
            float cc_x = -ya_x * sensor_x / yb_x * sx;
            float cc_y = -ya_y * sensor_y / yb_y * sy;
            float cc_r = semi_ap * 1.1 * max(sx / abs(yb_x), sy / abs(yb_y));
            bound_disk_intersection(cx, cy, ep_r, cc_x, cc_y, cc_r);
            if (ep_r <= 0.0)
                break;
        }

        float n1 = iors[i];
        float n2 = iors[i - 1];
        if (is_curved_surface(surface_types[i]) && n1 != n2) {
            float k = (n2 - n1) / radii[i];
            if (surface_types[i] != SURFACE_CYLINDRICAL_Y) {
                ua_x = (n1 * ua_x + ya_x * k) / n2;
                ub_x = (n1 * ub_x + yb_x * k) / n2;
            } else {
                ua_x *= n1 / n2;
                ub_x *= n1 / n2;
            }
            if (surface_types[i] != SURFACE_CYLINDRICAL_X) {
                ua_y = (n1 * ua_y + ya_y * k) / n2;
                ub_y = (n1 * ub_y + yb_y * k) / n2;
            } else {
                ua_y *= n1 / n2;
                ub_y *= n1 / n2;
            }
        } else if (n1 != n2) {
            ua_x *= n1 / n2;  ub_x *= n1 / n2;
            ua_y *= n1 / n2;  ub_y *= n1 / n2;
        }

        float t = thicknesses[i - 1];
        ya_x += ua_x * t;  yb_x += ub_x * t;
        ya_y += ua_y * t;  yb_y += ub_y * t;
    }

    if (ep_r > 0.0) {
        float rear_cx = cx, rear_cy = cy, rear_r = ep_r;
        cx = stop_cx;  cy = stop_cy;  ep_r = stop_r;
        bound_disk_intersection(cx, cy, ep_r, rear_cx, rear_cy, rear_r);
        clipped = (cx != stop_cx || cy != stop_cy || ep_r != stop_r);
    }

    ep_cx = cx / sx;
    ep_cy = cy / sy;
    if (ep_r < 0.0)
        ep_r = 0.0;
}

// ゴースト経路の 3 区間はどれも「頂点まで転送 -> 開口制約 -> 反射または屈折」の同じ手順なので 1 面分を共通化する
// n_after は屈折後の媒質 (進行方向で区間ごとに異なる)。reflect_here が真なら n_after は使わない
void ghost_abcd_surface(
    int i, int reflect_here, float n_after,
    float radii[MAX_SURFACES],
    float apertures[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    float vertex_z[MAX_SURFACES],
    float aperture_scale, float inv_sensor_aim,
    output float Ax, output float Bx, output float Cx, output float Dx,
    output float Ay, output float By, output float Cy, output float Dy,
    output float prev_z, output float cur_n, output float result)
{
    // Transfer from prev_z to vertex_z[i]
    float dist = vertex_z[i] - prev_z;
    float t = dist / cur_n;
    Ax += t * Cx;  Bx += t * Dx;
    Ay += t * Cy;  By += t * Dy;

    // Aperture constraint at this surface
    float semi_ap = surface_semi_aperture(i, apertures, surface_types, aperture_scale);
    float Meff_x = abs(Ax - Bx * inv_sensor_aim);
    float Meff_y = abs(Ay - By * inv_sensor_aim);
    float Meff = max(Meff_x, Meff_y);
    if (Meff > 1e-10) {
        float constraint = semi_ap / Meff;
        if (constraint < result)
            result = constraint;
    }

    // Power: refraction or reflection
    if (reflect_here) {
        // Reflection reverses the propagation direction, negating the
        // reduced angle u = n*dh/dz. In ABCD terms this negates C and D.
        // Curvature power is applied on top of the direction reversal.
        Cx = -Cx;  Dx = -Dx;
        Cy = -Cy;  Dy = -Dy;
        if (is_curved_surface(surface_types[i]) && radii[i] != 0.0) {
            float phi = 2.0 * cur_n / radii[i];
            apply_abcd_power(phi, surface_types[i], Ax, Bx, Ay, By, Cx, Dx, Cy, Dy);
        }
    } else if (surface_types[i] != SURFACE_STOP) {
        if (is_curved_surface(surface_types[i]) && cur_n != n_after) {
            float phi = (n_after - cur_n) / radii[i];
            apply_abcd_power(phi, surface_types[i], Ax, Bx, Ay, By, Cx, Dx, Cy, Dy);
        }
        cur_n = n_after;
    }

    prev_z = vertex_z[i];
}

// Per-pair ABCD trace through the full ghost path (all three phases including
// reflections) to find the tightest aperture constraint projected back to the
// aim plane. Returns a ghost-specific aim radius that replaces the main exit
// pupil radius for ghost ray sampling.
float compute_ghost_aim_radius(
    int bounce_a, int bounce_b,
    int num_surfaces,
    float radii[MAX_SURFACES],
    float iors[MAX_SURFACES],
    float apertures[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    float vertex_z[MAX_SURFACES],
    float aperture_scale,
    float sensor_z, float aim_z, float aim_semi_ap,
    output float out_Cx, output float out_Dx,
    output float out_Cy, output float out_Dy)
{
    float Ax = 1.0, Bx = 0.0, Cx = 0.0, Dx = 1.0;
    float Ay = 1.0, By = 0.0, Cy = 0.0, Dy = 1.0;

    float prev_z = aim_z;
    float cur_n = iors[num_surfaces - 1];
    float result = aim_semi_ap;
    float inv_sensor_aim = 1.0 / (sensor_z - aim_z);

    // Phase 1: aim plane → bounce_a (step -1, reflect at bounce_a)
    // Refraction (step -1): n_after = iors[i-1] or 1.0
    for (int i = num_surfaces - 1; i >= bounce_a; i--) {
        float n_after = (i > 0) ? iors[i - 1] : 1.0;
        ghost_abcd_surface(i, i == bounce_a, n_after,
                           radii, apertures, surface_types, vertex_z,
                           aperture_scale, inv_sensor_aim,
                           Ax, Bx, Cx, Dx, Ay, By, Cy, Dy, prev_z, cur_n, result);
    }

    // Phase 2: bounce_a+1 → bounce_b (step +1, reflect at bounce_b)
    // Refraction (step +1): n_after = iors[i]
    for (int i = bounce_a + 1; i <= bounce_b; i++) {
        ghost_abcd_surface(i, i == bounce_b, iors[i],
                           radii, apertures, surface_types, vertex_z,
                           aperture_scale, inv_sensor_aim,
                           Ax, Bx, Cx, Dx, Ay, By, Cy, Dy, prev_z, cur_n, result);
    }

    // Phase 3: bounce_b-1 → 0 (step -1, refraction only)
    for (int i = bounce_b - 1; i >= 0; i--) {
        float n_after = (i > 0) ? iors[i - 1] : 1.0;
        ghost_abcd_surface(i, 0, n_after,
                           radii, apertures, surface_types, vertex_z,
                           aperture_scale, inv_sensor_aim,
                           Ax, Bx, Cx, Dx, Ay, By, Cy, Dy, prev_z, cur_n, result);
    }

    out_Cx = Cx;  out_Dx = Dx;
    out_Cy = Cy;  out_Dy = Dy;
    return max(result, 0.0);
}

// ABCD-invert each scene light to find its aim-plane position for a given
// ghost pair. Returns 1 if any valid aim point was found, 0 otherwise.
// out_denom_x/y are the ABCD inversion denominators (needed for jitter).
int compute_light_aim_points(
    int num_lights,
    int light_types[MAX_LIGHTS],
    float light_pos[MAX_LIGHTS_3],
    float light_dir[MAX_LIGHTS_3],
    float light_intensity[MAX_LIGHTS],
    float g_Cx, float g_Dx, float g_Cy, float g_Dy,
    float sensor_x, float sensor_y, float sensor_z,
    float aim_z, float ghost_semi_ap, float front_z,
    output float aim_hx[MAX_LIGHTS],
    output float aim_hy[MAX_LIGHTS],
    output float aim_weights[MAX_LIGHTS],
    output float aim_total,
    output float out_denom_x, output float out_denom_y)
{
    aim_total = 0.0;
    float inv_sa = 1.0 / (sensor_z - aim_z);
    out_denom_x = g_Cx - g_Dx * inv_sa;
    out_denom_y = g_Cy - g_Dy * inv_sa;
    int valid_x = abs(out_denom_x) > 1e-12;
    int valid_y = abs(out_denom_y) > 1e-12;

    if (!valid_x && !valid_y)
        return 0;

    for (int li = 0; li < num_lights; li++) {
        aim_weights[li] = 0.0;
        float theta_x = 0.0, theta_y = 0.0;

        if (light_types[li] == 1) {
            float ldz = light_dir[li * 3 + 2];
            if (ldz >= 0.0) continue;
            theta_x = -light_dir[li * 3 + 0] / ldz;
            theta_y = -light_dir[li * 3 + 1] / ldz;
        } else {
            float lpz = light_pos[li * 3 + 2];
            if (lpz >= front_z) continue;
            float dz_inv = 1.0 / (front_z - lpz);
            theta_x = light_pos[li * 3 + 0] * dz_inv;
            theta_y = light_pos[li * 3 + 1] * dz_inv;
        }

        float hx = valid_x ? (-theta_x - g_Dx * sensor_x * inv_sa) / out_denom_x : 0.0;
        float hy = valid_y ? (-theta_y - g_Dy * sensor_y * inv_sa) / out_denom_y : 0.0;

        if (sqrt(hx * hx + hy * hy) > ghost_semi_ap * 1.5)
            continue;

        aim_hx[li] = hx;
        aim_hy[li] = hy;
        aim_weights[li] = light_intensity[li];
        aim_total += light_intensity[li];
    }

    return aim_total > 0.0 ? 1 : 0;
}

int intersect_sphere(
    point ray_origin,
    vector ray_dir,
    float sphere_center_z,
    float radius,
    output point hit_point)
{
    float ox = ray_origin[0];
    float oy = ray_origin[1];
    float oz = ray_origin[2] - sphere_center_z;
    float dx = ray_dir[0];
    float dy = ray_dir[1];
    float dz = ray_dir[2];

    float a = dx * dx + dy * dy + dz * dz;
    float b = 2.0 * (ox * dx + oy * dy + oz * dz);
    float c = ox * ox + oy * oy + oz * oz - radius * radius;

    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0)
        return 0;

    float sqrt_disc = sqrt(disc);
    float t1 = (-b - sqrt_disc) / (2.0 * a);
    float t2 = (-b + sqrt_disc) / (2.0 * a);

    // Pick the intersection closest to the vertex (sphere_center_z - radius).
    // Do NOT fall back to the far-side intersection — if the vertex-side hit
    // is behind the ray, the ray has passed this surface and should be rejected.
    float vertex_z = sphere_center_z - radius;
    point p1 = ray_origin + t1 * ray_dir;
    point p2 = ray_origin + t2 * ray_dir;

    float dist1 = abs(p1[2] - vertex_z);
    float dist2 = abs(p2[2] - vertex_z);

    if (dist1 < dist2) {
        if (t1 > 1e-6) {
            hit_point = p1;
            return 1;
        }
    } else {
        if (t2 > 1e-6) {
            hit_point = p2;
            return 1;
        }
    }

    return 0;
}

int intersect_cylindrical(
    point ray_origin,
    vector ray_dir,
    float sphere_center_z,
    float radius,
    int surface_type,
    output point hit_point)
{
    // Cylindrical surface: circle in one axis + z, infinite in the other.
    // SURFACE_CYLINDRICAL_X: curvature in X-Z plane (flat in Y)
    // SURFACE_CYLINDRICAL_Y: curvature in Y-Z plane (flat in X)
    float oz = ray_origin[2] - sphere_center_z;
    float dz = ray_dir[2];

    float oh, dh;
    if (surface_type == SURFACE_CYLINDRICAL_X) {
        oh = ray_origin[0];
        dh = ray_dir[0];
    } else {
        oh = ray_origin[1];
        dh = ray_dir[1];
    }

    float a = dh * dh + dz * dz;
    float b = 2.0 * (oh * dh + oz * dz);
    float c = oh * oh + oz * oz - radius * radius;

    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0)
        return 0;

    float sqrt_disc = sqrt(disc);
    float t1 = (-b - sqrt_disc) / (2.0 * a);
    float t2 = (-b + sqrt_disc) / (2.0 * a);

    float vertex_z = sphere_center_z - radius;
    point p1 = ray_origin + t1 * ray_dir;
    point p2 = ray_origin + t2 * ray_dir;

    float dist1 = abs(p1[2] - vertex_z);
    float dist2 = abs(p2[2] - vertex_z);

    if (dist1 < dist2) {
        if (t1 > 1e-6) {
            hit_point = p1;
            return 1;
        }
    } else {
        if (t2 > 1e-6) {
            hit_point = p2;
            return 1;
        }
    }

    return 0;
}

float aspheric_sag(float h, float c, float k, float A4, float A6, float A8, float A10) {
    float h2 = h * h;
    float Q = max(1.0 - (1.0 + k) * c * c * h2, 1e-20);
    float sag = c * h2 / (1.0 + sqrt(Q)) + A4 * h2 * h2 + A6 * h2 * h2 * h2
                + A8 * h2 * h2 * h2 * h2 + A10 * h2 * h2 * h2 * h2 * h2;
    return sag;
}

float aspheric_sag_prime(float h, float c, float k, float A4, float A6, float A8, float A10) {
    float h2 = h * h;
    float Q = max(1.0 - (1.0 + k) * c * c * h2, 1e-20);
    return c * h / sqrt(Q) + 4.0 * A4 * h * h2 + 6.0 * A6 * h * h2 * h2
           + 8.0 * A8 * h * h2 * h2 * h2 + 10.0 * A10 * h * h2 * h2 * h2 * h2;
}

int intersect_aspheric(
    point ray_origin, vector ray_dir,
    float vertex_z, float radius,
    float k, float A4, float A6, float A8, float A10,
    output point hit_point)
{
    // Seed with spherical intersection
    point sphere_hit = point(0, 0, 0);
    float sphere_center_z = vertex_z + radius;
    if (!intersect_sphere(ray_origin, ray_dir, sphere_center_z, radius, sphere_hit))
        return 0;

    float c = 1.0 / radius;
    float ox = ray_origin[0], oy = ray_origin[1], oz = ray_origin[2];
    float dx = ray_dir[0], dy = ray_dir[1], dz = ray_dir[2];

    // Initial t from sphere seed
    float t = (abs(dx) > abs(dy))
        ? (sphere_hit[0] - ox) / dx
        : (abs(dy) > 1e-10 ? (sphere_hit[1] - oy) / dy : (sphere_hit[2] - oz) / dz);

    // Newton-Raphson refinement
    float F = 0.0;
    for (int iter = 0; iter < 10; iter++) {
        float px = ox + t * dx;
        float py = oy + t * dy;
        float pz = oz + t * dz;
        float h = sqrt(px * px + py * py);
        float s = aspheric_sag(h, c, k, A4, A6, A8, A10);
        F = pz - vertex_z - s;
        if (abs(F) < 1e-8)
            break;
        float sp = aspheric_sag_prime(h, c, k, A4, A6, A8, A10);
        float dh_dt = (h > 1e-10) ? (px * dx + py * dy) / h : 0.0;
        float dF_dt = dz - sp * dh_dt;
        if (abs(dF_dt) < 1e-20)
            break;
        t -= F / dF_dt;
    }

    if (t < 1e-6 || abs(F) > 1e-4)
        return 0;

    hit_point = point(ox + t * dx, oy + t * dy, oz + t * dz);
    return 1;
}

// Geometry helper: find intersection point and surface normal for any surface type.
// Returns: 1=hit, 0=miss, -1=clipped
int find_surface_intersection(
    point ray_origin,
    vector ray_dir,
    float vertex_z,
    float radius,
    float semi_aperture,
    int surface_type,
    int num_blades,
    float blade_rotation,
    float k, float A4, float A6, float A8, float A10,
    output point hit_point,
    output vector surface_normal)
{
    if (!is_curved_surface(surface_type)) {
        float dz = ray_dir[2];
        if (abs(dz) < 1e-10)
            return 0;
        float t = (vertex_z - ray_origin[2]) / dz;
        if (t < 1e-6)
            return 0;
        hit_point = ray_origin + t * ray_dir;

        if (surface_type == SURFACE_STOP) {
            if (num_blades >= 3) {
                if (!point_in_ngon(hit_point[0], hit_point[1], semi_aperture, num_blades, blade_rotation))
                    return -1;
            } else {
                float r = sqrt(hit_point[0] * hit_point[0] + hit_point[1] * hit_point[1]);
                if (r > semi_aperture)
                    return -1;
            }
        } else {
            float r = sqrt(hit_point[0] * hit_point[0] + hit_point[1] * hit_point[1]);
            if (r > semi_aperture)
                return -1;
        }

        surface_normal = vector(0, 0, -1);
        return 1;
    }

    point hit = point(0, 0, 0);

    if (surface_type == SURFACE_ASPHERIC) {
        if (!intersect_aspheric(ray_origin, ray_dir, vertex_z, radius, k, A4, A6, A8, A10, hit))
            return 0;
    } else if (surface_type == SURFACE_CYLINDRICAL_X || surface_type == SURFACE_CYLINDRICAL_Y) {
        float cyl_center_z = vertex_z + radius;
        if (!intersect_cylindrical(ray_origin, ray_dir, cyl_center_z, radius, surface_type, hit))
            return 0;
    } else {
        float sphere_center_z = vertex_z + radius;
        if (!intersect_sphere(ray_origin, ray_dir, sphere_center_z, radius, hit))
            return 0;
    }

    float r = sqrt(hit[0] * hit[0] + hit[1] * hit[1]);
    if (r > semi_aperture)
        return -1;

    vector N;
    if (surface_type == SURFACE_ASPHERIC) {
        float c = 1.0 / radius;
        float h = sqrt(hit[0] * hit[0] + hit[1] * hit[1]);
        if (h > 1e-10) {
            float sp = aspheric_sag_prime(h, c, k, A4, A6, A8, A10);
            N = normalize(vector(-sp * hit[0] / h, -sp * hit[1] / h, 1.0));
        } else {
            N = vector(0, 0, 1);
        }
    } else if (surface_type == SURFACE_CYLINDRICAL_X) {
        float cyl_center_z = vertex_z + radius;
        N = normalize(vector(hit[0], 0, hit[2] - cyl_center_z));
    } else if (surface_type == SURFACE_CYLINDRICAL_Y) {
        float cyl_center_z = vertex_z + radius;
        N = normalize(vector(0, hit[1], hit[2] - cyl_center_z));
    } else {
        float sphere_center_z = vertex_z + radius;
        N = normalize(hit - point(0, 0, sphere_center_z));
    }

    hit_point = hit;
    surface_normal = N;
    return 1;
}

// Returns: 1 = success, 0 = intersection miss, -1 = aperture clip, -2 = TIR
int refract_at_surface(
    point ray_origin,
    vector ray_dir,
    float vertex_z,
    float radius,
    float semi_aperture,
    float n1,
    float n2,
    int num_blades,
    float blade_rotation,
    int surface_type,
    float lambda_nm,
    float coating,
    float k, float A4, float A6, float A8, float A10,
    output point new_origin,
    output vector new_dir,
    output float transmission)
{
    point hit = point(0, 0, 0);
    vector N = vector(0, 0, 0);
    int result = find_surface_intersection(
        ray_origin, ray_dir, vertex_z, radius, semi_aperture,
        surface_type, num_blades, blade_rotation,
        k, A4, A6, A8, A10, hit, N);

    if (result != 1)
        return result;

    new_origin = hit;

    if (surface_type == SURFACE_STOP) {
        new_dir = ray_dir;
        transmission = 1.0;
        return 1;
    }

    if (n1 == n2) {
        new_dir = ray_dir;
        transmission = 1.0;
        return 1;
    }

    vector I = normalize(ray_dir);
    if (dot(I, N) > 0.0)
        N = -N;

    float cos_i = abs(dot(I, N));
    vector refracted = refract(I, N, n1 / n2);
    if (dot(refracted, refracted) < 1e-10)
        return -2;

    float cos_t = abs(dot(refracted, N));
    transmission = fresnel_transmittance(n1, n2, cos_i, cos_t, lambda_nm, coating);
    new_dir = refracted;
    return 1;
}

// Returns: 1 = success, 0 = miss, -1 = clipped
int reflect_at_surface(
    point ray_origin,
    vector ray_dir,
    float vertex_z,
    float radius,
    float semi_aperture,
    float n1,
    float n2,
    int surface_type,
    float lambda_nm,
    float coating,
    float k, float A4, float A6, float A8, float A10,
    output point new_origin,
    output vector new_dir,
    output float reflectance)
{
    point hit = point(0, 0, 0);
    vector N = vector(0, 0, 0);
    int result = find_surface_intersection(
        ray_origin, ray_dir, vertex_z, radius, semi_aperture,
        surface_type, 0, 0.0,
        k, A4, A6, A8, A10, hit, N);

    if (result != 1)
        return result;

    vector I = normalize(ray_dir);
    if (dot(I, N) > 0.0)
        N = -N;

    float cos_i = abs(dot(I, N));
    new_origin = hit;
    new_dir = reflect(I, N);

    if (n1 == n2) {
        reflectance = 0.0;
        return 1;
    }

    float sin_t2 = (n1 * n1) / (n2 * n2) * (1.0 - cos_i * cos_i);
    float cos_t = (sin_t2 < 1.0) ? sqrt(1.0 - sin_t2) : 0.0;
    float T = fresnel_transmittance(n1, n2, cos_i, cos_t, lambda_nm, coating);
    // Cap reflectance to suppress near-TIR fireflies in ghost paths
    reflectance = min(1.0 - T, 0.25);
    return 1;
}

// 巻き戻し (Mirror) と先回り (Overshoot) の両ケースで同じ平面処理 (開口判定 + 屈折) を行うため共通化する
// Returns 1 on success; on failure sets failure_type (1 = miss, 2 = clip, 3 = TIR) and returns 0.
int pass_flat_surface(
    int flat_idx,
    float aperture_scale,
    float vertex_z[MAX_SURFACES],
    float iors[MAX_SURFACES],
    float apertures[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    float lambda_nm,
    int num_blades,
    float blade_rotation,
    float coating,
    output point p,
    output vector d,
    output float total_transmission,
    output int failure_type)
{
    float flat_semi_ap = surface_semi_aperture(flat_idx, apertures, surface_types, aperture_scale);

    point flat_p;
    int flat_check = check_aperture_at_plane(p, d, vertex_z[flat_idx], flat_semi_ap,
                                             surface_types[flat_idx], num_blades, blade_rotation, flat_p);
    if (flat_check != 1) {
        failure_type = (flat_check == 0) ? 1 : 2;
        return 0;
    }
    p = flat_p;

    if (surface_types[flat_idx] != SURFACE_STOP) {
        float fn1 = iors[flat_idx];
        float fn2 = (flat_idx > 0) ? iors[flat_idx - 1] : 1.0;
        vector flat_d; float flat_trans;
        if (!refract_at_flat_plane(d, fn1, fn2, lambda_nm, coating, flat_d, flat_trans)) {
            failure_type = 3;
            return 0;
        }
        total_transmission *= flat_trans;
        d = flat_d;
    }
    return 1;
}

// failure_type output: 0 = success, 1 = intersection miss, 2 = aperture clip, 3 = TIR
// iors は波長補正済み (dispersed_iors)、vertex_z は呼び出し側で計算済みのものを受け取る
// どちらも光線内で不変かつ射出瞳・ゴーストの計算と共有できるため、面ごとに cauchy_ior や頂点位置を求め直さない
int trace_lens_system(
    point ray_origin,
    vector ray_dir,
    float aperture_scale,
    int num_surfaces,
    float radii[MAX_SURFACES],
    float vertex_z[MAX_SURFACES],
    float iors[MAX_SURFACES],
    float apertures[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    float extra[MAX_EXTRA],
    float lambda_nm,
    int num_blades,
    float blade_rotation,
    float coating,
    output point exit_origin,
    output vector exit_dir,
    output int surfaces_passed,
    output int failure_type,
    output float total_transmission)
{
    surfaces_passed = 0;
    failure_type = 0;
    total_transmission = 1.0;

    point  p = ray_origin;
    vector d = ray_dir;

    // State saved before flat surfaces for sphere-overlap retry.
    // When a curved surface's sphere extends past an adjacent flat surface,
    // we may need to roll back and reprocess. Two cases:
    //   Overshoot: curved hit overshoots past the next flat — handle flat early
    //   Mirror: flat processed first but curved sphere is unreachable — retry
    point saved_p = point(0, 0, 0);
    vector saved_d = vector(0, 0, 0);
    float saved_transmission = 0.0;
    int saved_surfaces = 0;
    int saved_idx = -1;

    // Trace rear-to-front: last surface down to surface 0
    int skip_count = 0;
    for (int idx = num_surfaces - 1; idx >= 0; idx--) {
        if (skip_count > 0) {
            skip_count -= 1;
            saved_idx = -1;
            continue;
        }

        // Save ray state before flat surfaces for sphere-overlap retry
        if (!is_curved_surface(surface_types[idx])) {
            saved_p = p;
            saved_d = d;
            saved_transmission = total_transmission;
            saved_surfaces = surfaces_passed;
            saved_idx = idx;
        }

        float semi_ap = surface_semi_aperture(idx, apertures, surface_types, aperture_scale);

        // iors[i] = IOR of the medium between surface i and surface i+1
        // (toward sensor). When tracing sensor→scene at surface idx:
        // n1 = medium the ray is in (sensor side) = iors[idx]
        // n2 = medium the ray enters (scene side) = iors[idx-1] or air
        float n1 = iors[idx];
        float n2 = (idx > 0) ? iors[idx - 1] : 1.0;

        if (surface_types[idx] == SURFACE_STOP) {
            n1 = 1.0;
            n2 = 1.0;
        }

        int base = idx * N_EXTRA;
        float k_i = extra[base], A4_i = extra[base + 1], A6_i = extra[base + 2], A8_i = extra[base + 3], A10_i = extra[base + 4];

        point  new_p = point(0, 0, 0);
        vector new_d = vector(0, 0, 0);
        float surface_transmission = 1.0;

        int result = refract_at_surface(p, d, vertex_z[idx], radii[idx], semi_ap, n1, n2, num_blades, blade_rotation, surface_types[idx], lambda_nm, coating, k_i, A4_i, A6_i, A8_i, A10_i, new_p, new_d, surface_transmission);

        // Mirror case: a flat surface was processed but the adjacent curved
        // surface's sphere extends past it, making intersection unreachable.
        // Roll back to before the flat surface and retry the curved one first.
        if (result != 1 && is_curved_surface(surface_types[idx]) && saved_idx == idx + 1) {
            p = saved_p;
            d = saved_d;
            total_transmission = saved_transmission;
            surfaces_passed = saved_surfaces;
            saved_idx = -1;

            result = refract_at_surface(p, d, vertex_z[idx], radii[idx], semi_ap, n1, n2, num_blades, blade_rotation, surface_types[idx], lambda_nm, coating, k_i, A4_i, A6_i, A8_i, A10_i, new_p, new_d, surface_transmission);
            if (result != 1) {
                // refract_at_surface の 0 / -1 / -2 を failure_type の 1 / 2 / 3 に対応させる
                failure_type = 1 - result;
                return 0;
            }

            surfaces_passed += 1;
            total_transmission *= surface_transmission;
            p = new_p;
            d = new_d;

            // Now handle the flat surface we rolled back
            if (!pass_flat_surface(idx + 1, aperture_scale, vertex_z, iors, apertures, surface_types,
                                   lambda_nm, num_blades, blade_rotation, coating,
                                   p, d, total_transmission, failure_type))
                return 0;

            surfaces_passed += 1;
            continue;
        }

        if (result != 1) {
            failure_type = 1 - result;
            return 0;
        }

        surfaces_passed += 1;
        total_transmission *= surface_transmission;
        p = new_p;
        d = new_d;

        if (is_curved_surface(surface_types[idx]))
            saved_idx = -1;

        // Overshoot: a curved surface hit overshoots past the next flat
        // surface's vertex. Handle the flat surface now and skip it later.
        if (idx > 0 && !is_curved_surface(surface_types[idx - 1]) && p[2] < vertex_z[idx - 1]) {
            if (!pass_flat_surface(idx - 1, aperture_scale, vertex_z, iors, apertures, surface_types,
                                   lambda_nm, num_blades, blade_rotation, coating,
                                   p, d, total_transmission, failure_type))
                return 0;

            surfaces_passed += 1;
            skip_count = 1;
        }
    }

    exit_origin = p;
    exit_dir = d;
    return 1;
}

// Trace a contiguous range of surfaces [start_idx..end_idx] in the given direction.
// Refracts at each surface except reflect_at_idx where it reflects instead.
// iors は trace_lens_system と同じく波長補正済みのものを受け取る
int trace_surface_range(
    int start_idx, int end_idx, int step, int reflect_at_idx,
    point p_in, vector d_in,
    float aperture_scale,
    int num_surfaces,
    float radii[MAX_SURFACES],
    float iors[MAX_SURFACES],
    float apertures[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    float extra[MAX_EXTRA],
    float vertex_z[MAX_SURFACES],
    float lambda_nm,
    int num_blades,
    float blade_rotation,
    float coating,
    output point p_out,
    output vector d_out,
    output float total_transmission)
{
    p_out = p_in;
    d_out = d_in;
    total_transmission = 1.0;

    for (int idx = start_idx; ; idx += step) {
        float semi_ap = surface_semi_aperture(idx, apertures, surface_types, aperture_scale);

        float n1, n2;
        if (step < 0) {
            n1 = iors[idx];
            n2 = (idx > 0) ? iors[idx - 1] : 1.0;
        } else {
            n1 = (idx > 0) ? iors[idx - 1] : 1.0;
            n2 = iors[idx];
        }
        if (surface_types[idx] == SURFACE_STOP) {
            n1 = 1.0;
            n2 = 1.0;
        }

        int base = idx * N_EXTRA;
        float k_i = extra[base], A4_i = extra[base + 1], A6_i = extra[base + 2];
        float A8_i = extra[base + 3], A10_i = extra[base + 4];

        point new_p = point(0, 0, 0);
        vector new_d = vector(0, 0, 0);

        if (idx == reflect_at_idx) {
            float reflectance = 0.0;
            int result = reflect_at_surface(
                p_out, d_out, vertex_z[idx], radii[idx], semi_ap,
                n1, n2, surface_types[idx], lambda_nm, coating,
                k_i, A4_i, A6_i, A8_i, A10_i,
                new_p, new_d, reflectance);
            if (result != 1)
                return 0;
            total_transmission *= reflectance;
        } else {
            float trans = 1.0;
            int result = refract_at_surface(
                p_out, d_out, vertex_z[idx], radii[idx], semi_ap,
                n1, n2, num_blades, blade_rotation, surface_types[idx], lambda_nm, coating,
                k_i, A4_i, A6_i, A8_i, A10_i,
                new_p, new_d, trans);
            if (result != 1)
                return 0;
            total_transmission *= trans;
        }

        p_out = new_p;
        d_out = new_d;

        if (idx == end_idx)
            break;
    }

    return 1;
}

// Trace a ghost path with two reflections: bounce_a (front-ward) and bounce_b (rear-ward).
// bounce_a < bounce_b. The ray refracts normally except at the two bounce surfaces.
int trace_ghost_path(
    int bounce_a, int bounce_b,
    point p_in, vector d_in,
    float aperture_scale,
    int num_surfaces,
    float radii[MAX_SURFACES],
    float iors[MAX_SURFACES],
    float apertures[MAX_SURFACES],
    int surface_types[MAX_SURFACES],
    float extra[MAX_EXTRA],
    float vertex_z[MAX_SURFACES],
    float lambda_nm,
    int num_blades,
    float blade_rotation,
    float coating,
    output point p_out,
    output vector d_out,
    output float total_transmission)
{
    total_transmission = 1.0;
    p_out = p_in;
    d_out = d_in;
    float phase_T = 1.0;

    // Phase 1: sensor → front, reflect at bounce_a
    if (!trace_surface_range(
            num_surfaces - 1, bounce_a, -1, bounce_a,
            p_out, d_out, aperture_scale, num_surfaces,
            radii, iors, apertures, surface_types, extra, vertex_z,
            lambda_nm, num_blades, blade_rotation, coating,
            p_out, d_out, phase_T))
        return 0;
    total_transmission *= phase_T;

    // Phase 2: front → rear, reflect at bounce_b
    if (!trace_surface_range(
            bounce_a + 1, bounce_b, 1, bounce_b,
            p_out, d_out, aperture_scale, num_surfaces,
            radii, iors, apertures, surface_types, extra, vertex_z,
            lambda_nm, num_blades, blade_rotation, coating,
            p_out, d_out, phase_T))
        return 0;
    total_transmission *= phase_T;

    // Phase 3: rear → front, normal refraction to exit
    if (bounce_b > 0) {
        if (!trace_surface_range(
                bounce_b - 1, 0, -1, -1,
                p_out, d_out, aperture_scale, num_surfaces,
                radii, iors, apertures, surface_types, extra, vertex_z,
                lambda_nm, num_blades, blade_rotation, coating,
                p_out, d_out, phase_T))
            return 0;
        total_transmission *= phase_T;
    }

    return 1;
}

// sinc²(u) = (sin(πu) / πu)²。回折の照準あり・なし両方の重みで同じ式を使う
float sinc2(float u)
{
    if (abs(u) < 1e-6)
        return 1.0;
    float piu = M_PI * u;
    float s = sin(piu) / piu;
    s *= s;
    return s;
}

// 絞り羽根 edge の辺に垂直な光条の向き。光条の選択と照準で同じ角度を使う必要がある
// point_in_ngon() と開口の標本化は頂点を blade_rot_rad + k·2π/n に置くため、辺 k の法線 (= 光条の向き) は頂点の中間角になる
float spike_edge_angle(float blade_rot_rad, int edge, int n)
{
    return blade_rot_rad + (float(edge) + 0.5) * 2.0 * M_PI / float(n);
}

// Aperture diffraction starburst via two-component mixture model.
// Core rays (most energy) pass through unperturbed; spike rays are deflected
// along edge-perpendicular directions with Cauchy-sampled sinc² weighting.
// 光条の PSF は光条 k ごとの「軸方向 sinc²(u/θ0) × 直交方向 sinc²(v/θ0⊥)」を光条数で平均した平面上の密度 (積分 1)
// ライト照準と MIS で混ぜるには両方の標本化が同じ 2 次元の測度を持つ必要があるため、直交方向も Cauchy で標本化する
void sample_diffraction_spike(
    int n, float blade_rot_rad, float theta0, float theta0_perp,
    float hash_edge, float hash_u, float hash_v,
    output float px, output float py)
{
    // Spike ray: select a random edge and sample along its perpendicular
    int edge = int(floor(hash_edge * float(n)));
    if (edge >= n) edge = n - 1;
    float spike_angle = spike_edge_angle(blade_rot_rad, edge, n);

    // Cauchy with scale 1/π importance-samples sinc² with near-flat weights:
    // peak weight ~1.4 at u≈0.48, vs π≈3.14 with scale 1
    float hu = clamp(hash_u, 1e-6, 1.0 - 1e-6);
    float hv = clamp(hash_v, 1e-6, 1.0 - 1e-6);
    float u = tan(M_PI * (hu - 0.5)) / M_PI * theta0;
    float v = tan(M_PI * (hv - 0.5)) / M_PI * theta0_perp;

    float c = cos(spike_angle);
    float s = sin(spike_angle);
    px = u * c - v * s;
    py = u * s + v * c;
}

// 摂動 (px, py) での光条 PSF と、sample_diffraction_spike() の標本化密度 (全光条の混合) を返す
void diffraction_psf_pdf(
    int n, float blade_rot_rad, float theta0, float theta0_perp,
    float px, float py,
    output float psf, output float pdf)
{
    psf = 0.0;
    pdf = 0.0;
    for (int k = 0; k < n; k++) {
        float a = spike_edge_angle(blade_rot_rad, k, n);
        float c = cos(a);
        float s = sin(a);
        float u = (px * c + py * s) / theta0;
        float v = (-px * s + py * c) / theta0_perp;
        psf += sinc2(u) * sinc2(v);
        pdf += 1.0 / ((1.0 + M_PI * M_PI * u * u) * (1.0 + M_PI * M_PI * v * v));
    }
    float norm = 1.0 / (float(n) * theta0 * theta0_perp);
    psf *= norm;
    pdf *= norm;
}

// 直接光・ゴーストとも初期光線に同じ cos^4 減光を掛ける
float cos4_falloff(vector dir)
{
    vector axis = vector(0, 0, -1);
    float cos_theta = dot(normalize(dir), axis);
    return cos_theta * cos_theta * cos_theta * cos_theta;
}

// レンズ空間 (mm, -Z が被写体側) から Blender カメラ空間 (m, +Z が被写体側) への変換と分光重みは直接光・ゴーストで共通
void write_camera_ray(
    point exit_p, vector exit_d, float w, float lambda, int chromatic_aberration,
    output point position, output vector direction, output color throughput)
{
    position = point(exit_p[0] * 0.001,
                     exit_p[1] * 0.001,
                     -exit_p[2] * 0.001);
    direction = normalize(vector(exit_d[0], exit_d[1], -exit_d[2]));

    if (chromatic_aberration) {
        color spectral_norm = color(1.7050, 2.5996, 2.7576);
        color rgb_w = wavelength_to_rgb(lambda) * spectral_norm;
        throughput = color(w * rgb_w[0], w * rgb_w[1], w * rgb_w[2]);
    } else {
        throughput = color(w, w, w);
    }
}

// CDF scan to select light proportional to intensity
// 見つからないときの扱いがゴーストと回折で異なるため、-1 を返して呼び出し側に任せる
int select_light(int num_lights, float weights[MAX_LIGHTS], float total, float hash)
{
    float target = hash * total;
    float cumul = 0.0;
    for (int li = 0; li < num_lights; li++) {
        if (weights[li] <= 0.0) continue;
        cumul += weights[li];
        if (cumul >= target)
            return li;
    }
    return -1;
}

// Sum pair weights (R_a * R_b) for importance sampling CDF
// Σ_{a<b} R_a R_b = Σ_a R_a * (後方の R の和) なので、接尾和で O(N) にする
// 波長依存 (分散・コーティング) のため焼き込めず、二重ループだと最大 630 組を光線ごとに走査することになる
float ghost_pair_total_weight(
    int num_surfaces,
    float surface_R[MAX_SURFACES],
    output float suffix_R[MAX_SURFACES],
    output int num_pairs)
{
    float total = 0.0;
    float suffix_sum = 0.0;
    int num_reflective = 0;
    for (int i = num_surfaces - 1; i >= 0; i--) {
        suffix_R[i] = suffix_sum;
        if (surface_R[i] < 1e-10) continue;
        suffix_sum += surface_R[i];
        total += surface_R[i] * suffix_R[i];
        num_reflective++;
    }
    num_pairs = num_reflective * (num_reflective - 1) / 2;
    return total;
}

// Select pair with probability proportional to R_a * R_b
// Returns 1 if a pair was found (0 only on floating-point edge cases).
int select_ghost_pair(
    int num_surfaces,
    float surface_R[MAX_SURFACES],
    float suffix_R[MAX_SURFACES],
    float target_w,
    output int ghost_a, output int ghost_b, output float pair_weight)
{
    ghost_a = -1;
    float cumulative = 0.0;

    for (int a = 0; a < num_surfaces && ghost_a < 0; a++) {
        if (surface_R[a] < 1e-10) continue;
        // 行 a の組をまとめて飛ばし、目標を含む行だけ b を走査する (CDF の順序は二重ループと同じ)
        float row_w = surface_R[a] * suffix_R[a];
        if (cumulative + row_w < target_w) {
            cumulative += row_w;
            continue;
        }
        for (int b = a + 1; b < num_surfaces && ghost_a < 0; b++) {
            if (surface_R[b] < 1e-10) continue;
            cumulative += surface_R[a] * surface_R[b];
            if (cumulative >= target_w) {
                ghost_a = a;
                ghost_b = b;
                pair_weight = surface_R[a] * surface_R[b];
            }
        }
    }
    return ghost_a >= 0;
}

// ライト照準の標本化: 強度比でライトを選び、そのライトのジッタ楕円 (中心 cx/cy、半軸 rx/ry) 内で一様に標本化する
// 密度は light_target_pdf() と厳密に一致させる必要がある (MIS の重みに使うため)
void sample_light_target(
    int num_lights, float weights[MAX_LIGHTS], float total,
    float cx[MAX_LIGHTS], float cy[MAX_LIGHTS],
    float rx[MAX_LIGHTS], float ry[MAX_LIGHTS],
    float hash_sel, float hash_r, float hash_a,
    output float x, output float y)
{
    int sel = select_light(num_lights, weights, total, hash_sel);
    // Guard against floating-point edge case where CDF
    // scan doesn't match — fall back to last valid light
    if (sel < 0) {
        for (int li = 0; li < num_lights; li++) {
            if (weights[li] > 0.0) sel = li;
        }
    }
    float r = sqrt(hash_r);
    float a = hash_a * 2.0 * M_PI;
    x = cx[sel] + r * cos(a) * rx[sel];
    y = cy[sel] + r * sin(a) * ry[sel];
}

// sample_light_target() の密度: 全照準ライトのジッタ楕円の一様密度を選択確率で重み付けした和
float light_target_pdf(
    int num_lights, float weights[MAX_LIGHTS], float total,
    float cx[MAX_LIGHTS], float cy[MAX_LIGHTS],
    float rx[MAX_LIGHTS], float ry[MAX_LIGHTS],
    float x, float y)
{
    float pdf = 0.0;
    for (int li = 0; li < num_lights; li++) {
        if (weights[li] <= 0.0) continue;
        float dx = (x - cx[li]) / rx[li];
        float dy = (y - cy[li]) / ry[li];
        if (dx * dx + dy * dy <= 1.0)
            pdf += weights[li] / (M_PI * rx[li] * ry[li]);
    }
    return pdf / total;
}

// ゴースト光線をライトへ向ける照準先。ABCD 逆算で得た照準面上の点を中心に、ライトの見かけの大きさを照準面へ写した楕円を返す
// 半径 0 のライト (デルタ分布) は密度を評価できず MIS に混ぜられないため照準対象から外す
// X/Y どちらかの逆算が退化している画素は楕円にならないため照準しない
// Returns 1 if any light can be aimed at, 0 for uniform sampling only.
int ghost_light_targets(
    int num_lights,
    int light_types[MAX_LIGHTS],
    float light_pos[MAX_LIGHTS_3],
    float light_dir[MAX_LIGHTS_3],
    float light_intensity[MAX_LIGHTS],
    float light_radius[MAX_LIGHTS],
    float g_Cx, float g_Dx, float g_Cy, float g_Dy,
    float sensor_x, float sensor_y, float sensor_z,
    float aim_z, float ghost_semi_ap, float front_z,
    output float cx[MAX_LIGHTS], output float cy[MAX_LIGHTS],
    output float rx[MAX_LIGHTS], output float ry[MAX_LIGHTS],
    output float weights[MAX_LIGHTS], output float total)
{
    float denom_x = 0.0, denom_y = 0.0;
    total = 0.0;

    if (!compute_light_aim_points(
            num_lights, light_types, light_pos,
            light_dir, light_intensity,
            g_Cx, g_Dx, g_Cy, g_Dy,
            sensor_x, sensor_y, sensor_z,
            aim_z, ghost_semi_ap, front_z,
            cx, cy, weights, total,
            denom_x, denom_y))
        return 0;

    total = 0.0;
    if (abs(denom_x) <= 1e-12 || abs(denom_y) <= 1e-12)
        return 0;

    for (int li = 0; li < num_lights; li++) {
        if (weights[li] <= 0.0) continue;
        // Jitter for light angular size
        float radius_angle = 0.0;
        if (light_types[li] == 1) {
            radius_angle = SUN_ANGULAR_RADIUS;
        } else {
            float d = front_z - light_pos[li * 3 + 2];
            if (d > 1.0)
                radius_angle = light_radius[li] / d;
        }
        if (radius_angle <= 0.0) {
            weights[li] = 0.0;
            continue;
        }
        rx[li] = radius_angle / abs(denom_x);
        ry[li] = radius_angle / abs(denom_y);
        total += weights[li];
    }
    return total > 0.0 ? 1 : 0;
}

// 回折光条をライト方向へ向ける照準先。射出光線からのライト方向 (tan 空間) を中心に、ライトの角半径の円を返す
// 半径 0 の点光源は照準対象から外す
// Returns 1 if any light can be aimed at, 0 for uniform sampling only.
int diffraction_light_targets(
    int num_lights,
    int light_types[MAX_LIGHTS],
    float light_pos[MAX_LIGHTS_3],
    float light_dir[MAX_LIGHTS_3],
    float light_intensity[MAX_LIGHTS],
    float light_radius[MAX_LIGHTS],
    point exit_origin, float exit_ax, float exit_ay,
    output float cx[MAX_LIGHTS], output float cy[MAX_LIGHTS],
    output float r[MAX_LIGHTS],
    output float weights[MAX_LIGHTS], output float total)
{
    total = 0.0;
    for (int li = 0; li < num_lights; li++) {
        weights[li] = 0.0;
        float tx = 0.0, ty = 0.0;
        float light_r = 0.0;

        if (light_types[li] == 1) {
            float ldz = light_dir[li * 3 + 2];
            if (ldz >= 0.0) continue;
            tx = -light_dir[li * 3 + 0] / ldz;
            ty = -light_dir[li * 3 + 1] / ldz;
            light_r = SUN_ANGULAR_RADIUS;
        } else {
            float dx = light_pos[li * 3 + 0] - exit_origin[0];
            float dy = light_pos[li * 3 + 1] - exit_origin[1];
            float dz = light_pos[li * 3 + 2] - exit_origin[2];
            if (dz >= 0.0) continue;
            tx = dx / (-dz);
            ty = dy / (-dz);
            light_r = light_radius[li] / (-dz);
        }
        if (light_r <= 0.0) continue;
        // Relative to exit direction (diffraction PSF is centered there)
        cx[li] = tx - exit_ax;
        cy[li] = ty - exit_ay;
        r[li] = light_r;
        weights[li] = light_intensity[li];
        total += light_intensity[li];
    }
    return total > 0.0 ? 1 : 0;
}

shader lens_camera(
    float aperture_scale = 1.0
        [[ string description = "Scale factor for the aperture stop opening. 1.0 = wide open." ]],
    int aperture_blades = 0
        [[ string description = "Number of aperture blades. 0 = circular." ]],
    float blade_rotation = 0.0
        [[ string description = "Aperture blade rotation in degrees." ]],
    int chromatic_aberration = 1
        [[ string description = "Enable chromatic aberration (spectral dispersion)." ]],
    int lens_ghosts = 0
        [[ string description = "Enable ghost/flare simulation (double-bounce reflections)." ]],
    float ghost_intensity = 1.0
        [[ string description = "Brightness multiplier for ghost images." ]],
    int diffraction = 0
        [[ string description = "Enable aperture diffraction (starburst spikes)." ]],
    float debug_mode = 0.0
        [[ string description = "0=normal, 1=pinhole, 2=diagnostic, 3=exit dir, 4=ghosts only, 5=ghost aim" ]],
    // {{SCENE_LIGHT_PARAMS}}
    output point position = 0,
    output vector direction = 0,
    output color throughput = 1)
{
    // Sensor size from Blender camera
    vector sensor_size = 0;
    getattribute("cam:sensor_size", sensor_size);
    float sensor_w = sensor_size[0];
    float sensor_h = sensor_size[1];

    float focal_distance = 0.0;
    getattribute("cam:focal_distance", focal_distance);

    // Raster position (0-1 range)
    point raster = camera_shader_raster_position();
    float rx = raster[0];
    float ry = raster[1];

    // Map raster coordinates to physical sensor position (mm).
    // Negate to compensate for lens inversion (real lenses flip the image).
    float sensor_x = (0.5 - rx) * sensor_w;
    float sensor_y = (0.5 - ry) * sensor_h;

    // debug_mode は float で渡るため、各モードの範囲 [k-0.5, k+0.5) を一度だけ整数に丸めて比較する
    int debug_view = int(floor(debug_mode + 0.5));

    // Debug mode 1: pinhole camera to verify the framework
    // +Z is the view direction in Blender's OSL camera convention
    if (debug_view == 1) {
        position = point(0, 0, 0);
        direction = normalize(vector(-sensor_x, -sensor_y, 50.0));
        throughput = 1.0;
        return;
    }

    // Load lens data
    float radii[MAX_SURFACES];
    float thicknesses[MAX_SURFACES];
    float iors[MAX_SURFACES];
    float apertures[MAX_SURFACES];
    float abbe_v[MAX_SURFACES];
    int surface_types[MAX_SURFACES];
    float extra[MAX_EXTRA];
    float thicknesses_close[MAX_SURFACES];
    load_lens_data(radii, thicknesses, iors, apertures, abbe_v,
                   surface_types, extra, thicknesses_close);

    int num_surfaces = NUM_SURFACES;
    float coating = COATING;

    // Anamorphic desqueeze: narrow sensor X sampling so the lens squeeze produces correct proportions
    sensor_x /= SQUEEZE;

    int stop_index = STOP_INDEX;

    float focus_mm = focal_distance * 1000.0;

    // Interpolate variable thicknesses for current focus distance.
    // Uses linear interpolation in reciprocal object-distance space.
    // ピント距離は cam:focal_distance で実行時に読む (アニメーション可) ため、補間以降はシェーダー内に残す
    // 焼き込むとピント変更のたびに再コンパイルが必要になる
    if (FOCUS_CLOSE_DISTANCE > 0.0 && focus_mm > 0.0) {
        float d_obj = focus_mm - TOTAL_LENGTH_INF;
        float alpha = (d_obj > 0.0)
            ? clamp(FOCUS_CLOSE_DISTANCE / d_obj, 0.0, 1.0)
            : 1.0;

        for (int i = 0; i < num_surfaces; i++)
            thicknesses[i] = mix(thicknesses[i], thicknesses_close[i], alpha);
    }

    float total_length = 0.0;
    for (int i = 0; i < num_surfaces - 1; i++)
        total_length += thicknesses[i];
    float sensor_distance = compute_sensor_distance(
        num_surfaces, radii, thicknesses, iors, surface_types, total_length, focus_mm);

    // Compute vertex z-positions (PBRT convention: front at most negative z,
    // rear at z=0). This ensures sphere curvature pushes off-axis hits away
    // from subsequent surfaces, preventing overshoot at thin air gaps.
    float vertex_z[MAX_SURFACES];
    vertex_z[0] = -total_length;
    for (int i = 1; i < num_surfaces; i++)
        vertex_z[i] = vertex_z[i - 1] + thicknesses[i - 1];

    // camera_shader_random_sample() provides two uniform values in x/y.
    // x = aperture angle (sector + barycentric u1), y = barycentric u2; the
    // actual aperture radius is derived from both barycentric coordinates.
    // Wavelength is derived from a hash of both to avoid correlation with
    // aperture position — a linear mapping would preserve the quasi-random
    // sequence structure and create systematic color-position patterns.
    point rnd = camera_shader_random_sample();

    // Wavelength sampling for chromatic aberration
    float lambda = 587.6;
    float r_param = rnd[1];
    if (chromatic_aberration) {
        lambda = 400.0 + rng(rnd[0], rnd[1], 0) * 300.0;
    }

    // Compute wavelength-adjusted IOR for exit pupil aiming and Fresnel
    // normalization. Lenses with high dispersion shift the exit pupil at
    // extreme wavelengths; d-line-only aiming causes intersection misses.
    float dispersed_iors[MAX_SURFACES];
    for (int i = 0; i < num_surfaces; i++)
        dispersed_iors[i] = cauchy_ior(iors[i], abbe_v[i], lambda);

    float surface_R[MAX_SURFACES];
    float onaxis_T = onaxis_fresnel_transmission(num_surfaces, dispersed_iors, lambda, coating, surface_R);

    // Lens layout: rear element at z=0, front element at z=-total_length.
    // Sensor is behind the rear element at z = +sensor_distance.
    float sensor_z = sensor_distance;
    point sensor_point = point(sensor_x, sensor_y, sensor_z);

    // Compute the aperture stop's z-position
    // vertex_z と同じ順序の累積和なので、足し直さずそのまま使える
    float stop_z = vertex_z[stop_index];

    // Sample on the exit pupil plane to reduce wasted rays for off-axis points.
    // The exit pupil is the image of the aperture stop as seen through the rear
    // lens group — it differs in position and size from the physical stop.
    // For anamorphic lenses, the exit pupil has separate X/Y magnifications.
    float stop_semi_ap = apertures[stop_index] * 0.5 * aperture_scale;

    float ep_z_x = 0.0, ep_mag_x = 1.0;
    float ep_z_y = 0.0, ep_mag_y = 1.0;
    compute_exit_pupil(num_surfaces, radii, thicknesses, dispersed_iors, surface_types,
                       ep_z_x, ep_mag_x, ep_z_y, ep_mag_y);

    // Use Y-axis exit pupil for aim position (focus axis)
    float aim_z = (ep_mag_y > 0.0) ? ep_z_y : stop_z;
    float aim_semi_ap_y = (ep_mag_y > 0.0) ? stop_semi_ap * ep_mag_y : stop_semi_ap;

    // Project X exit pupil to the aim plane by matching angular subtense.
    // For anamorphic lenses the X exit pupil can be far from the Y one
    // (even behind the sensor), so raw magnification at the wrong Z gives
    // a wildly wrong aperture size. For spherical lenses ep_z_x == ep_z_y
    // and the projection is a no-op.
    float aim_semi_ap_x = aim_semi_ap_y;
    if (ep_mag_x > 0.0) {
        float x_pupil_semi_ap = stop_semi_ap * ep_mag_x;
        float dist_to_ep_x = abs(sensor_z - ep_z_x);
        float dist_to_aim  = abs(sensor_z - aim_z);
        if (dist_to_ep_x > 1e-6)
            aim_semi_ap_x = x_pupil_semi_ap * dist_to_aim / dist_to_ep_x;
    }
    float aim_semi_ap = max(aim_semi_ap_x, aim_semi_ap_y);

    // Scale field exit pupil separately for X and Y
    // 楕円の射出瞳を半径 aim_semi_ap の円に写す倍率。円盤の計算はこの座標で行い、最後に軸ごとに戻す
    float pupil_sx = 1.0, pupil_sy = 1.0;
    // 割る側の aim_semi_ap_y を判定しないと、Y 側だけ 0 のとき ratio が発散する
    if (aim_semi_ap_y > 1e-10) {
        float ratio = aim_semi_ap_x / aim_semi_ap_y;
        if (ratio > 1.0) {
            pupil_sy = ratio;
        } else if (ratio < 1.0) {
            pupil_sx = 1.0 / ratio;
        }
    }

    float ep_cx = 0.0, ep_cy = 0.0, field_semi_ap = aim_semi_ap;
    int field_clipped = 0;
    compute_field_exit_pupil(sensor_x, sensor_y, sensor_z,
                             aim_z, stop_semi_ap, aim_semi_ap, pupil_sx, pupil_sy,
                             num_surfaces,
                             radii, thicknesses, dispersed_iors, apertures, surface_types,
                             ep_cx, ep_cy, field_semi_ap, field_clipped);

    if (field_semi_ap <= 0.0) {
        throughput = 0.0;
        return;
    }

    // 下の n 角形は円に内接するため、後群で絞った円をそのまま使うと円と n 角形の隙間を通る光線を取りこぼす
    // 絞りの像そのもの (n 角形の絞りに一致) でなければ、円を内接円に持つ n 角形まで広げて通過領域を含める
    if (field_clipped && aperture_blades >= 3)
        field_semi_ap /= cos(M_PI / float(aperture_blades));

    float field_semi_ap_x = field_semi_ap / pupil_sx;
    float field_semi_ap_y = field_semi_ap / pupil_sy;
    float onaxis_area = max(aim_semi_ap_x * aim_semi_ap_y, 1e-20);
    float sampling_area_ratio = (field_semi_ap_x * field_semi_ap_y) / onaxis_area;
    float blade_rot_rad = blade_rotation * M_PI / 180.0;

    float ax = 0.0;
    float ay = 0.0;

    // Ngon barycentric sampling with separate X/Y scale factors for
    // elliptical exit pupil (anamorphic lenses). For spherical lenses,
    // field_semi_ap_x == field_semi_ap_y — identical behavior.
    // For circular aperture (blades=0), use 128-gon as a proxy.
    {
        int n = (aperture_blades >= 3) ? aperture_blades : 128;
        float sector_angle = 2.0 * M_PI / float(n);
        int sector = int(floor(rnd[0] * float(n)));
        if (sector >= n) sector = n - 1;
        float u1 = rnd[0] * float(n) - float(sector);
        float u2 = r_param;
        if (u1 + u2 > 1.0) {
            u1 = 1.0 - u1;
            u2 = 1.0 - u2;
        }
        float a0 = blade_rot_rad + float(sector) * sector_angle;
        float a1 = blade_rot_rad + float(sector + 1) * sector_angle;
        ax = u1 * field_semi_ap_x * cos(a0) + u2 * field_semi_ap_x * cos(a1);
        ay = u1 * field_semi_ap_y * sin(a0) + u2 * field_semi_ap_y * sin(a1);
    }

    ax += ep_cx;
    ay += ep_cy;

    point aperture_point = point(ax, ay, aim_z);

    // Initial ray: sensor toward the stop
    vector initial_dir = normalize(aperture_point - sensor_point);

    // Ghost path handling: importance-sample pairs by normal-incidence R²
    int trace_ghost = 0;
    int num_ghost_pairs = 0;
    int ghost_a = -1, ghost_b = -1;
    float ghost_pair_weight = 0.0;
    float ghost_total_weight = 0.0;
    float adaptive_frac = 0.0;

    if (lens_ghosts) {
        // Normal-incidence Fresnel reflectance per surface (with coating)
        // onaxis_fresnel_transmission() で求めた値を再利用する。絞りは反射面にならないので除く
        surface_R[stop_index] = 0.0;

        float suffix_R[MAX_SURFACES];
        ghost_total_weight = ghost_pair_total_weight(num_surfaces, surface_R, suffix_R, num_ghost_pairs);

        if (num_ghost_pairs > 0 && ghost_total_weight > 0.0) {
            // Adaptive sample allocation: spend more on bright ghosts (uncoated),
            // less on dim ghosts (multicoated). sqrt() tames the quadratic growth
            // of total_weight with surface count.
            adaptive_frac = clamp(
                sqrt(ghost_total_weight) * ghost_intensity * 2.0,
                0.02, 0.5);

            float ghost_hash = rng(rnd[0], rnd[1], 1);

            if (debug_view == 4 || ghost_hash < adaptive_frac) {
                float pair_hash = rng(rnd[0], rnd[1], 2);
                trace_ghost = select_ghost_pair(num_surfaces, surface_R, suffix_R,
                                                pair_hash * ghost_total_weight,
                                                ghost_a, ghost_b, ghost_pair_weight);
            }
        }
    }

    // 回折で光条を出すかは乱数だけで決まる。ライトを照準に使うのは光条側の光線 (6 枚で約 7%) だけなので、読み込み前に判定する
    int diffraction_spike = 0;
    if (diffraction && aperture_blades >= 3) {
        // spike_energy: fraction of PSF energy in diffraction spikes
        float spike_energy = 0.5 * (1.0 - cos(M_PI / float(aperture_blades)));
        diffraction_spike = (rng(rnd[0], rnd[1], 6) < spike_energy) ? 1 : 0;
    }

    // Load scene lights once for both ghost aiming and diffraction
    // ライトを使うのはゴースト光線と回折だけ。ワールド -> カメラ変換は光線ごとだと重いため、使う光線に限って読み込む
    // (カメラ移動で再コンパイルしない設計なので、変換自体は焼き込めない)
    // 読み込みはシェーダーパラメーターを参照するため関数に出せず、使う光線の判定を 1 か所にまとめて絞る
    int num_lights = 0;
    int light_types[MAX_LIGHTS];
    float light_pos[MAX_LIGHTS_3];
    float light_dir[MAX_LIGHTS_3];
    float light_intensity[MAX_LIGHTS];
    float light_radius[MAX_LIGHTS];
    if (trace_ghost || diffraction_spike) {
        // {{LOAD_SCENE_LIGHTS}}
        transform_lights_to_camera(num_lights, light_types, light_pos, light_dir);
    }

    // Debug mode 4: ghosts only — kill direct rays
    if (debug_view == 4 && !trace_ghost) {
        throughput = 0.0;
        return;
    }

    // Debug mode 5: ghost aim diagnostic
    // R = num_lights / MAX_LIGHTS, G = light aiming valid, B = trace_ghost
    if (debug_view == 5) {
        position = point(0, 0, 0);
        direction = normalize(vector(-sensor_x, -sensor_y, 50.0));

        if (!trace_ghost) {
            throughput = 0.0;
            return;
        }

        float dbg_Cx = 0.0, dbg_Dx = 0.0, dbg_Cy = 0.0, dbg_Dy = 0.0;
        float dbg_semi_ap = compute_ghost_aim_radius(
            ghost_a, ghost_b, num_surfaces,
            radii, dispersed_iors, apertures, surface_types, vertex_z,
            aperture_scale, sensor_z, aim_z, aim_semi_ap,
            dbg_Cx, dbg_Dx, dbg_Cy, dbg_Dy);
        dbg_semi_ap = min(dbg_semi_ap * 1.1, aim_semi_ap);

        float dbg_g = 0.0;
        if (num_lights > 0 && dbg_semi_ap > 0.0) {
            float dbg_hx[MAX_LIGHTS], dbg_hy[MAX_LIGHTS];
            float dbg_w[MAX_LIGHTS], dbg_total = 0.0;
            float dbg_dx = 0.0, dbg_dy = 0.0;
            if (compute_light_aim_points(
                    num_lights, light_types, light_pos,
                    light_dir, light_intensity,
                    dbg_Cx, dbg_Dx, dbg_Cy, dbg_Dy,
                    sensor_x, sensor_y, sensor_z,
                    aim_z, dbg_semi_ap, vertex_z[0],
                    dbg_hx, dbg_hy, dbg_w, dbg_total,
                    dbg_dx, dbg_dy))
                dbg_g = 1.0;
        }

        float dbg_r = float(num_lights) / float(MAX_LIGHTS);
        throughput = color(dbg_r, dbg_g, 1.0);
        return;
    }

    if (trace_ghost) {
        // ABCD ghost pupil: trace paraxial matrices through the full ghost
        // path to find the tightest aperture constraint at the aim plane.
        // Also returns the C,D matrix elements for ABCD inversion (light aiming).
        // Circular sampling (not elliptical) allows anamorphic cylindrical
        // reflections to form vertical streaks.
        float g_Cx = 0.0, g_Dx = 0.0, g_Cy = 0.0, g_Dy = 0.0;
        float ghost_semi_ap = compute_ghost_aim_radius(
            ghost_a, ghost_b, num_surfaces,
            radii, dispersed_iors, apertures, surface_types, vertex_z,
            aperture_scale, sensor_z, aim_z, aim_semi_ap,
            g_Cx, g_Dx, g_Cy, g_Dy);
        ghost_semi_ap = min(ghost_semi_ap * 1.1, aim_semi_ap);

        // 70/30 split: aim at lights vs uniform disk, combined by one-sample MIS (balance heuristic)
        // 重みは f / (0.7·p_aim + 0.3·p_uniform)。照準できるライトがない画素は一様のみで f / p_uniform
        float light_hash = rng(rnd[0], rnd[1], 3);
        float aim_x = 0.0, aim_y = 0.0;

        float front_z = vertex_z[0];
        float ghost_disk_area = M_PI * ghost_semi_ap * ghost_semi_ap;

        float tgt_cx[MAX_LIGHTS], tgt_cy[MAX_LIGHTS], tgt_rx[MAX_LIGHTS], tgt_ry[MAX_LIGHTS];
        float tgt_w[MAX_LIGHTS], tgt_total = 0.0;
        int has_targets = 0;
        if (num_lights > 0 && ghost_semi_ap > 0.0) {
            has_targets = ghost_light_targets(
                num_lights, light_types, light_pos, light_dir,
                light_intensity, light_radius,
                g_Cx, g_Dx, g_Cy, g_Dy,
                sensor_x, sensor_y, sensor_z,
                aim_z, ghost_semi_ap, front_z,
                tgt_cx, tgt_cy, tgt_rx, tgt_ry, tgt_w, tgt_total);
        }

        if (has_targets && light_hash < LIGHT_AIM_FRACTION) {
            sample_light_target(num_lights, tgt_w, tgt_total, tgt_cx, tgt_cy, tgt_rx, tgt_ry,
                                rng(rnd[0], rnd[1], 4), rng(rnd[0], rnd[1], 5), rnd[1],
                                aim_x, aim_y);
        } else {
            float ghost_r_u = sqrt(r_param) * ghost_semi_ap;
            float ghost_angle_u = rnd[0] * 2.0 * M_PI;
            aim_x = ghost_r_u * cos(ghost_angle_u);
            aim_y = ghost_r_u * sin(ghost_angle_u);
        }

        // 被積分関数は一様標本化の円盤上で定義する。照準楕円が円盤からはみ出した部分の標本は寄与 0
        // (円盤は通過領域を外側から包むので、はみ出した光線は元々ほぼ通らない)
        float inv_pdf = 0.0;
        if (ghost_disk_area > 0.0 && aim_x * aim_x + aim_y * aim_y <= ghost_semi_ap * ghost_semi_ap) {
            float pdf = 1.0 / ghost_disk_area;
            if (has_targets)
                pdf = LIGHT_AIM_FRACTION
                        * light_target_pdf(num_lights, tgt_w, tgt_total, tgt_cx, tgt_cy, tgt_rx, tgt_ry, aim_x, aim_y)
                    + (1.0 - LIGHT_AIM_FRACTION) * pdf;
            inv_pdf = 1.0 / pdf;
        }
        if (inv_pdf <= 0.0) {
            throughput = 0.0;
            return;
        }

        point ghost_aperture = point(aim_x, aim_y, aim_z);
        vector ghost_initial_dir = normalize(ghost_aperture - sensor_point);

        point ghost_exit = point(0, 0, 0);
        vector ghost_dir = vector(0, 0, 0);
        float ghost_T = 0.0;

        int ghost_ok = trace_ghost_path(
            ghost_a, ghost_b, sensor_point, ghost_initial_dir,
            aperture_scale, num_surfaces,
            radii, dispersed_iors, apertures, surface_types, extra, vertex_z,
            lambda, aperture_blades, blade_rot_rad, coating,
            ghost_exit, ghost_dir, ghost_T);

        if (ghost_ok) {
            float weight = cos4_falloff(ghost_initial_dir);

            float frac = (debug_view == 4) ? 1.0 : adaptive_frac;
            // Ghost rays sample a smaller disk than direct rays — scale by
            // the area ratio so ghosts contribute proportional étendue.
            // 直接光と同じく軸上の全射出瞳の面積を基準にする (画素ごとに絞った円盤で割ると周辺でゴーストが明るくなる)
            // 直接光は外接半径 1 の n 角形 (面積 n/2·sin(2π/n)) で標本化するため、円で標本化するゴーストとは形の面積比も掛ける
            // 一様標本化のみなら 1/pdf は円盤の面積。MIS では混合密度の逆数 inv_pdf に置き換わる
            int n_direct = (aperture_blades >= 3) ? aperture_blades : 128;
            float ngon_area = 0.5 * float(n_direct) * sin(2.0 * M_PI / float(n_direct));
            float area_ratio = inv_pdf / (ngon_area * onaxis_area);
            float w = weight * (ghost_T / onaxis_T)
                    * (ghost_total_weight / ghost_pair_weight) / frac * ghost_intensity
                    * area_ratio;

            write_camera_ray(ghost_exit, ghost_dir, w, lambda, chromatic_aberration,
                             position, direction, throughput);
        } else {
            throughput = 0.0;
        }
        return;
    }

    // Direct path: trace through the lens system
    point  exit_origin = point(0, 0, 0);
    vector exit_dir = vector(0, 0, 0);
    int surfaces_passed = 0;
    int failure_type = 0;
    float total_transmission = 0.0;

    int ok = trace_lens_system(sensor_point, initial_dir, aperture_scale,
                               num_surfaces,
                               radii, vertex_z, dispersed_iors, apertures,
                               surface_types, extra, lambda,
                               aperture_blades, blade_rot_rad, coating,
                               exit_origin, exit_dir, surfaces_passed, failure_type,
                               total_transmission);

    // Debug mode 2: failure cause diagnostic.
    // White = all passed.
    // Green = aperture clip, Blue = TIR, Red = intersection miss.
    // Brightness = how far the ray got.
    if (debug_view == 2) {
        position = point(0, 0, 0);
        direction = normalize(vector(-sensor_x, -sensor_y, 50.0));
        if (ok) {
            throughput = color(1, 1, 1);
        } else {
            float brightness = float(surfaces_passed) / float(num_surfaces);
            float is_clip = (failure_type == 2) ? brightness : 0.0;
            float is_tir = (failure_type == 3) ? brightness : 0.0;
            float is_miss = (failure_type == 1) ? brightness : 0.0;
            throughput = color(is_miss, is_clip, is_tir);
        }
        return;
    }

    // Debug mode 3: exit direction as RGB (only for rays that survive)
    if (debug_view == 3) {
        if (ok) {
            vector d_norm = normalize(exit_dir);
            position = point(0, 0, 0);
            direction = normalize(vector(-sensor_x, -sensor_y, 50.0));
            throughput = color(d_norm[0] * 0.5 + 0.5,
                               d_norm[1] * 0.5 + 0.5,
                               d_norm[2] * 0.5 + 0.5);
        } else {
            throughput = 0.0;
        }
        return;
    }

    if (ok) {
        float weight = cos4_falloff(initial_dir);

        // 周辺では後群の口径に合わせて円盤を絞って一様に標本化するため、推定量に円盤の面積を掛けないと後群による口径食が消える
        // 軸上の全射出瞳の面積で割り、絞りを変えても露出が変わらない正規化は保つ
        float w = weight * (total_transmission / onaxis_T) * sampling_area_ratio;

        // Compensate for fewer direct samples when ghosts are active
        if (lens_ghosts && num_ghost_pairs > 0)
            w /= (1.0 - adaptive_frac);

        // Aperture diffraction: perturb exit direction to produce starbursts.
        // 70/30 mixture: aim spikes at scene lights vs Cauchy sampling, combined by one-sample MIS (balance heuristic).
        // 光条の重みは PSF / (0.7·p_aim + 0.3·p_uniform)。照準できるライトがなければ PSF / p_uniform
        // 摂動は射出方向の tan 空間 (x/-z, y/-z) で与え、照準先のライト方向と同じ空間で扱う
        if (diffraction && aperture_blades >= 3 && exit_dir[2] < -1e-6) {
            int n = aperture_blades;
            float stop_d = stop_semi_ap * 2.0;
            if (stop_d < 1e-6) stop_d = 1e-6;
            float theta0 = (lambda * 1e-6) / (stop_d * cos(M_PI / float(n)));
            float theta0_perp = (lambda * 1e-6) / (stop_d * sin(M_PI / float(n)));

            float diff_h2 = rng(rnd[0], rnd[1], 7);
            float diff_h3 = rng(rnd[0], rnd[1], 8);

            if (diffraction_spike) {
                // Exit ray angular components (relative to optical axis)
                float exit_ax = exit_dir[0] / (-exit_dir[2]);
                float exit_ay = exit_dir[1] / (-exit_dir[2]);

                float tgt_cx[MAX_LIGHTS], tgt_cy[MAX_LIGHTS], tgt_r[MAX_LIGHTS];
                float tgt_w[MAX_LIGHTS], tgt_total = 0.0;
                int has_targets = 0;
                if (num_lights > 0) {
                    has_targets = diffraction_light_targets(
                        num_lights, light_types, light_pos, light_dir,
                        light_intensity, light_radius,
                        exit_origin, exit_ax, exit_ay,
                        tgt_cx, tgt_cy, tgt_r, tgt_w, tgt_total);
                }

                float px = 0.0, py = 0.0;
                float aim_hash = rng(rnd[0], rnd[1], 9);
                if (has_targets && aim_hash < LIGHT_AIM_FRACTION) {
                    sample_light_target(num_lights, tgt_w, tgt_total, tgt_cx, tgt_cy, tgt_r, tgt_r,
                                        rng(rnd[0], rnd[1], 10), rng(rnd[0], rnd[1], 11), diff_h2,
                                        px, py);
                } else {
                    sample_diffraction_spike(n, blade_rot_rad, theta0, theta0_perp,
                                             diff_h2, diff_h3, rng(rnd[0], rnd[1], 12),
                                             px, py);
                }

                float psf = 0.0, pdf = 0.0;
                diffraction_psf_pdf(n, blade_rot_rad, theta0, theta0_perp, px, py, psf, pdf);
                if (has_targets)
                    pdf = LIGHT_AIM_FRACTION
                            * light_target_pdf(num_lights, tgt_w, tgt_total, tgt_cx, tgt_cy, tgt_r, tgt_r, px, py)
                        + (1.0 - LIGHT_AIM_FRACTION) * pdf;

                w *= (pdf > 0.0) ? psf / pdf : 0.0;
                exit_dir = normalize(vector(exit_ax + px, exit_ay + py, -1.0));
            }
        }

        write_camera_ray(exit_origin, exit_dir, w, lambda, chromatic_aberration,
                         position, direction, throughput);
    } else {
        throughput = 0.0;
    }
}
